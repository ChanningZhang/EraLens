      "start": { "year": -3000, "month": 1, "abs": -35988, "confidence": "approximate_year" },
      "end": { "year": -2000, "month": 12, "abs": -23977, "confidence": "approximate_year" },
      "summary": "新石器晚期黑陶文化，分布于山东、河南、山西、陕西等地。蛋壳黑陶、夯土城址，下接二里头等早期青铜文化。",
      "startAbs": -35988,
      "endAbs": -23977
    },
    {
      "kind": "culture",
      "timeMode": "span",
      "id": "taosi",
      "name": "陶寺文化",
      "dateNote": "陶寺中期约前2100–前2000；观象台或可上溯至距今约4700年。此取龙山时代晋南陶寺通行年。",
      "start": { "year": -2300, "month": 1, "abs": -27588, "confidence": "approximate_year" },
