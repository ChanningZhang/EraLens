generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id          String              @id
  name        String
  altNames    String[]            @default([]) @map("alt_names")
  ancestralXing String?           @map("ancestral_xing")
  clanShi     String?             @map("clan_shi")
  birthYear   Int?                @map("birth_year")
  birthMonth  Int?                @map("birth_month")
  deathYear   Int?                @map("death_year")
  deathMonth  Int?                @map("death_month")
  roles       String[]            @default([])
  bio         String?
  links       Json                @default("[]")
  posthumousName String?          @map("posthumous_name")
  templeName  String?             @map("temple_name")
  reigns      Reign[]
  participants EventParticipant[]

  @@index([birthYear])
  @@index([deathYear])
  @@index([name])
  @@map("persons")
}

model DynastyGroup {
  id          String    @id
  name        String
  altNames    String[]  @default([]) @map("alt_names")
  scope       String    @default("cn")
  startYear   Int       @map("start_year")
  startMonth  Int       @map("start_month")
  endYear     Int       @map("end_year")
  endMonth    Int       @map("end_month")
  startAbs    Int       @map("start_abs")
  endAbs      Int       @map("end_abs")
  precision   String    @default("year")
  note        String?
  dynasties   Dynasty[]

  @@index([scope, startAbs, endAbs])
  @@map("dynasty_groups")
}

model Dynasty {
  id          String           @id
  name        String
  ancestralXing String?        @map("ancestral_xing")
  clanShi     String?          @map("clan_shi")
  altNames    String[]         @default([]) @map("alt_names")
  scope       String           @default("cn")
  region      String           @default("east_asia")
  startYear   Int              @map("start_year")
  startMonth  Int              @map("start_month")
  endYear     Int              @map("end_year")
  endMonth    Int              @map("end_month")
  startAbs    Int              @map("start_abs")
  endAbs      Int              @map("end_abs")
  precision   String           @default("year")
  colorToken  String           @map("color_token")
  orthodoxFromAbs Int?         @map("orthodox_from_abs")
  orthodoxEndAbs  Int?         @map("orthodox_end_abs")
  parentId    String?          @map("parent_id")
  groupId     String?          @map("group_id")
  note        String?
  group       DynastyGroup?    @relation(fields: [groupId], references: [id])
  reigns      Reign[]
  eventDynasties EventDynasty[]

  @@index([startYear])
  @@index([endYear])
  @@index([scope, startAbs, endAbs])
  @@index([groupId])
  @@map("dynasties")
}

model Reign {
  id                    String      @id
  dynastyId             String      @map("dynasty_id")
  personId              String      @map("person_id")
  title                 String
  eraNames              String?     @map("era_names")
  preferredAppellation  Json?       @map("preferred_appellation")
  startYear             Int         @map("start_year")
  startMonth            Int         @map("start_month")
  startDay              Int?        @map("start_day")
  endYear               Int         @map("end_year")
  endMonth              Int         @map("end_month")
  endDay                Int?        @map("end_day")
  startAbs              Int         @map("start_abs")
  endAbs                Int         @map("end_abs")
  precision             String      @default("year")
  startDateConfidence   String?     @map("start_date_confidence")
  endDateConfidence     String?     @map("end_date_confidence")
  claimTrack            String?     @map("claim_track")
  claimLabel            String?     @map("claim_label")
  claimRole             String?     @map("claim_role")
  dynasty               Dynasty     @relation(fields: [dynastyId], references: [id])
  person                Person      @relation(fields: [personId], references: [id])

  @@index([startYear])
  @@index([endYear])
  @@index([dynastyId])
  @@index([personId])
  @@index([claimTrack])
  @@map("reigns")
}

model Event {
  id          String              @id
  name        String
  kind        String              @default("other")
  timeMode    String              @default("point") @map("time_mode")
  precision   String              @default("year")
  dateNote    String?             @map("date_note")
  atYear      Int?                @map("at_year")
  atMonth     Int?                @map("at_month")
  atAbs       Int?                @map("at_abs")
  startYear   Int?                @map("start_year")
  startMonth  Int?                @map("start_month")
  startAbs    Int?                @map("start_abs")
  endYear     Int?                @map("end_year")
  endMonth    Int?                @map("end_month")
  endAbs      Int?                @map("end_abs")
  summary     String?
  meaning     String?
  dynasties   EventDynasty[]
  participants EventParticipant[]

  @@index([atYear])
  @@index([startYear])
  @@index([endYear])
  @@map("events")
}

model EventDynasty {
  eventId   String  @map("event_id")
  dynastyId String  @map("dynasty_id")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dynasty   Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@id([eventId, dynastyId])
  @@map("event_dynasties")
}

model EventParticipant {
  eventId  String @map("event_id")
  personId String @map("person_id")
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@map("event_participants")
}

model Relation {
  id        String  @id
  fromType  String  @map("from_type")
  fromId    String  @map("from_id")
  toType    String  @map("to_type")
  toId      String  @map("to_id")
  kind      String
  atYear    Int?    @map("at_year")
  atMonth   Int?    @map("at_month")
  atAbs     Int?    @map("at_abs")
  precision String? @default("year")
  eventId   String? @map("event_id")

  @@unique([fromType, fromId, toType, toId, kind])
  @@map("relations")
}

model DynastyLaneGroup {
  id                 String   @id
  primaryDynastyId   String   @map("primary_dynasty_id")
  phaseDynastyIds    String[] @map("phase_dynasty_ids")
  laneOrderStartAbs  Int      @map("lane_order_start_abs")
  laneOrderEndAbs    Int      @map("lane_order_end_abs")

  @@map("dynasty_lane_groups")
}
