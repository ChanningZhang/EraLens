generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id          String              @id
  name        String
  altNames    String[]            @default([]) @map("alt_names")
  ancestralXing String?           @map("ancestral_xing")
  clanShi     String?             @map("clan_shi")
  birthYear   Int?                @map("birth_year")
  birthMonth  Int?                @map("birth_month")
  deathYear   Int?                @map("death_year")
  deathMonth  Int?                @map("death_month")
  roles       String[]            @default([])
  bio         String?
  links       Json                @default("[]")
  posthumousName String?          @map("posthumous_name")
  templeName  String?             @map("temple_name")
  title       String?
  searchTerms String[]            @default([]) @map("search_terms")
  reigns      Reign[]
  participants EventParticipant[]

  @@index([birthYear])
  @@index([deathYear])
  @@index([name])
  @@index([searchTerms], type: Gin, map: "persons_search_terms_gin_idx")
  @@map("persons")
}

model DynastyGroup {
  id          String    @id
  name        String
  altNames    String[]  @default([]) @map("alt_names")
  scope       String    @default("cn")
  startYear   Int       @map("start_year")
  startMonth  Int       @map("start_month")
  endYear     Int       @map("end_year")
  endMonth    Int       @map("end_month")
  startAbs    Int       @map("start_abs")
  endAbs      Int       @map("end_abs")
  precision   String    @default("year")
  note        String?
  dynasties   Dynasty[]

  @@index([scope, startAbs, endAbs])
  @@map("dynasty_groups")
}

model Dynasty {
  id          String           @id
  name        String
  altNames    String[]         @default([]) @map("alt_names")
  scope       String           @default("cn")
  region      String           @default("east_asia")
  startYear   Int              @map("start_year")
  startMonth  Int              @map("start_month")
  endYear     Int              @map("end_year")
  endMonth    Int              @map("end_month")
  startAbs    Int              @map("start_abs")
  endAbs      Int              @map("end_abs")
  precision   String           @default("year")
  colorToken  String           @map("color_token")
  parentId    String?          @map("parent_id")
  groupId     String?          @map("group_id")
  note        String?
  group       DynastyGroup?    @relation(fields: [groupId], references: [id])
  reigns      Reign[]
  eventDynasties EventDynasty[]
  capitals    DynastyCapital[]

  @@index([startYear])
  @@index([endYear])
  @@index([scope, startAbs, endAbs])
  @@index([groupId])
  @@map("dynasties")
}

model Reign {
  id                    String      @id
  dynastyId             String      @map("dynasty_id")
  personId              String      @map("person_id")
  title                 String
  eraNames              String?     @map("era_names")
  startYear             Int         @map("start_year")
  startMonth            Int         @map("start_month")
  startDay              Int?        @map("start_day")
  endYear               Int         @map("end_year")
  endMonth              Int         @map("end_month")
  endDay                Int?        @map("end_day")
  startAbs              Int         @map("start_abs")
  endAbs                Int         @map("end_abs")
  precision             String      @default("year")
  startDateConfidence   String?     @map("start_date_confidence")
  endDateConfidence     String?     @map("end_date_confidence")
  claimTrack            String?     @map("claim_track")
  claimLabel            String?     @map("claim_label")
  claimRole             String?     @map("claim_role")
  isInformalMonarch     Boolean     @default(false) @map("is_informal_monarch")
  isMain              Boolean?    @map("is_main")
  dynasty               Dynasty     @relation(fields: [dynastyId], references: [id])
  person                Person      @relation(fields: [personId], references: [id])

  @@index([startYear])
  @@index([endYear])
  @@index([dynastyId])
  @@index([personId])
  @@index([claimTrack])
  @@map("reigns")
}

model Event {
  id          String              @id
  name        String
  kind        String              @default("other")
  timeMode    String              @default("point") @map("time_mode")
  precision   String              @default("year")
  dateNote    String?             @map("date_note")
  atYear      Int?                @map("at_year")
  atMonth     Int?                @map("at_month")
  atAbs       Int?                @map("at_abs")
  startYear   Int?                @map("start_year")
  startMonth  Int?                @map("start_month")
  startAbs    Int?                @map("start_abs")
  endYear     Int?                @map("end_year")
  endMonth    Int?                @map("end_month")
  endAbs      Int?                @map("end_abs")
  summary     String?
  meaning     String?
  content     String?
  locationId  String?             @map("location_id")
  location    EventLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  dynasties   EventDynasty[]
  participants EventParticipant[]

  @@index([atYear])
  @@index([startYear])
  @@index([endYear])
  @@index([locationId])
  @@map("events")
}

model EventLocation {
  id               String   @id
  historicalName   String   @map("historical_name")
  modernName       String   @map("modern_name")
  longitude        Decimal  @db.Decimal(10, 7)
  latitude         Decimal  @db.Decimal(10, 7)
  coordinateSystem String   @default("WGS84") @map("coordinate_system")
  precision        String   @default("approximate")
  note             String?
  links            Json     @default("[]")
  events           Event[]

  @@map("event_locations")
}

model EventDynasty {
  eventId   String  @map("event_id")
  dynastyId String  @map("dynasty_id")
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dynasty   Dynasty @relation(fields: [dynastyId], references: [id], onDelete: Cascade)

  @@id([eventId, dynastyId])
  @@map("event_dynasties")
}

model EventParticipant {
  eventId  String @map("event_id")
  personId String @map("person_id")
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@map("event_participants")
}

model Relation {
  id        String  @id
  fromType  String  @map("from_type")
  fromId    String  @map("from_id")
  toType    String  @map("to_type")
  toId      String  @map("to_id")
  kind      String
  atYear    Int?    @map("at_year")
  atMonth   Int?    @map("at_month")
  atAbs     Int?    @map("at_abs")
  precision String? @default("year")
  eventId   String? @map("event_id")

  @@unique([fromType, fromId, toType, toId, kind])
  @@map("relations")
}

model DynastyLaneGroup {
  id                 String   @id
  primaryDynastyId   String   @map("primary_dynasty_id")
  phaseDynastyIds    String[] @map("phase_dynasty_ids")
  laneOrderStartAbs  Int      @map("lane_order_start_abs")
  laneOrderEndAbs    Int      @map("lane_order_end_abs")

  @@map("dynasty_lane_groups")
}

model DynastyCapital {
  id                  String   @id
  dynastyId           String   @map("dynasty_id")
  historicalName      String   @map("historical_name")
  modernName          String   @map("modern_name")
  longitude           Decimal  @db.Decimal(10, 7)
  latitude            Decimal  @db.Decimal(10, 7)
  coordinateSystem    String   @default("GCJ02") @map("coordinate_system")
  startYear           Int      @map("start_year")
  startMonth          Int      @map("start_month")
  startDay            Int?     @map("start_day")
  endYear             Int      @map("end_year")
  endMonth            Int      @map("end_month")
  endDay              Int?     @map("end_day")
  startAbs            Int      @map("start_abs")
  endAbs              Int      @map("end_abs")
  precision           String   @default("year")
  endPrecision        String?  @map("end_precision")
  startDateConfidence String?  @map("start_date_confidence")
  endDateConfidence   String?  @map("end_date_confidence")
  role                String   @default("primary")
  claimTrack          String?  @map("claim_track")
  note                String?
  links               Json     @default("[]")
  dynasty             Dynasty  @relation(fields: [dynastyId], references: [id])

  @@index([dynastyId])
  @@index([startAbs, endAbs])
  @@map("dynasty_capitals")
}
